{
  "entities": {
    "users": {
      "title": "users",
      "description": "User account profiles and roles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "approvalStatus": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["fullName", "email", "role"]
    },
    "courses": {
      "title": "courses",
      "description": "SmartTech courses catalog and details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "titleAr": { "type": "string" },
        "titleEn": { "type": "string" },
